+++ b/bsd/dev/Sm8250TouchBoard.c
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <vm/memory_types.h>
+
+#include "Sm8250TouchProbe.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t physical, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t address, vm_size_t size);
+extern void thread_terminate_self(void);
+
+/* Stock IN2020 DTB, Qualcomm SM8250 GCC and TLMM register layouts. */
+enum {
+    GccBranchPage = 0x00118000,
+    GccVotePage = 0x00150000,
+    GccWrap1Vote = 0x2008,
+    GccWrap1M_Ahb = 0x004,
+    GccWrap1S_Ahb = 0x008,
+    GccWrap1S5 = 0x5fc,
+    GccVotesRequired = (1 << 20) | (1 << 21) | (1 << 27),
+    TlmmGpio36Page = 0x0f524000,
+    TlmmPinStride = 0x1000,
+    TlmmMuxMask = 0xf << 2,
+    TlmmQup13 = 1 << 2,
+    TlmmOutputEnable = 1 << 9,
+    TlmmData = 4,
+    TlmmInputHigh = 1,
+    TlmmOutputHigh = 2,
+    Se13Page = 0x00a94000,
+    WindowSize = 0x4000,
+};
+
+static uint32_t
+read_reg(void *window, uint32_t offset)
+{
+    return *(volatile uint32_t *)((uintptr_t)window + offset);
+}
+
+static void
+write_reg(void *window, uint32_t offset, uint32_t value)
+{
+    *(volatile uint32_t *)((uintptr_t)window + offset) = value;
+    __asm__ volatile("dmb oshst" ::: "memory");
+}
+
+static vm_offset_t
+map_window(vm_offset_t physical)
+{
+    return ml_io_map_unmappable(physical, WindowSize, VM_WIMG_IO);
+}
+
+static bool
+clocks_ready(void)
+{
+    vm_offset_t branches = map_window(GccBranchPage);
+    vm_offset_t votes = map_window(GccVotePage);
+    bool ready = false;
+    if (branches && votes) {
+        uint32_t ma = read_reg((void *)branches, GccWrap1M_Ahb);
+        uint32_t sa = read_reg((void *)branches, GccWrap1S_Ahb);
+        uint32_t se = read_reg((void *)branches, GccWrap1S5);
+        uint32_t vote = read_reg((void *)votes, GccWrap1Vote);
+        ready = !((ma | sa | se) & (1u << 31)) &&
+            (vote & GccVotesRequired) == GccVotesRequired;
+        printf("TOUCH38 clocks ready=%u vote=%x m=%x s=%x se=%x\n", ready, vote, ma, sa, se);
+    } else {
+        printf("TOUCH38 clocks mapping failed\n");
+    }
+    if (votes) {
+        ml_io_unmap(votes, WindowSize);
+    }
+    if (branches) {
+        ml_io_unmap(branches, WindowSize);
+    }
+    return ready;
+}
+
+static bool
+pins_ready(void)
+{
+    vm_offset_t pins = map_window(TlmmGpio36Page);
+    if (!pins) {
+        printf("TOUCH38 pins mapping failed\n");
+        return false;
+    }
+    uint32_t config[4], data[4];
+    for (unsigned pin = 0; pin < 4; ++pin) {
+        config[pin] = read_reg((void *)pins, pin * TlmmPinStride);
+        data[pin] = read_reg((void *)pins, pin * TlmmPinStride + TlmmData);
+    }
+    ml_io_unmap(pins, WindowSize);
+    bool ready = (config[0] & TlmmMuxMask) == TlmmQup13 &&
+        (config[1] & TlmmMuxMask) == TlmmQup13 &&
+        (config[2] & (TlmmMuxMask | TlmmOutputEnable)) == TlmmOutputEnable &&
+        (data[2] & TlmmOutputHigh) &&
+        (data[0] & data[1] & TlmmInputHigh);
+    printf("TOUCH38 pins ready=%u sda=%x/%x scl=%x/%x reset=%x/%x irq=%x/%x\n",
+        ready, config[0], data[0], config[1], data[1], config[2], data[2], config[3], data[3]);
+    return ready;
+}
+
+static void
+probe_once(void)
+{
+    bool clocks = clocks_ready();
+    bool pins = pins_ready();
+    if (!clocks || !pins) {
+        printf("TOUCH38 skipped clocks=%u pins=%u\n", clocks, pins);
+        return;
+    }
+
+    vm_offset_t engine = map_window(Se13Page);
+    if (!engine) {
+        printf("TOUCH38 engine mapping failed\n");
+        return;
+    }
+    printf("TOUCH38 examining SE13 at 0x%x\n", Se13Page);
+    const GeniIo io = {read_reg, write_reg, (void *)engine};
+    Sm8250TouchResult chip;
+    int status = sm8250_touch_read_chip(&io, delay, &chip);
+    printf("TOUCH38 result=%d config=%x reg=%02x boot=%02x integrity=%02x error=%d irq=%x\n",
+        status, chip.config, chip.reg, chip.boot, chip.integrity, chip.error, chip.irq_status);
+    ml_io_unmap(engine, WindowSize);
+}
+
+static void
+probe_thread(void *unused, wait_result_t result)
+{
+    (void)unused;
+    (void)result;
+    probe_once();
+    thread_terminate_self();
+}
+
+void sm8250_touch_probe_start(void);
+
+void
+sm8250_touch_probe_start(void)
+{
+    int enabled = 0;
+    if (!PE_parse_boot_argn("sm8250-touch-probe", &enabled, sizeof(enabled)) || enabled != 1) {
+        return;
+    }
+    thread_t worker;
+    kern_return_t status = kernel_thread_start(probe_thread, NULL, &worker);
+    if (status == KERN_SUCCESS) {
+        thread_deallocate(worker);
+    } else {
+        printf("TOUCH38 cannot start probe thread: %d\n", status);
+    }
+}
--- /dev/null
+++ b/bsd/dev/Sm8250TouchProbe.c
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "Sm8250TouchProbe.h"
+
+enum {
+    GeniStatus = 0x40,
+    GeniCommandActive = (1 << 0) | (1 << 12),
+    GeniTxFifoStatus = 0x800,
+    GeniGsiEventEnable = 0xe18,
+    SensorAddress = 0x48,
+    SensorBootStatus = 0x55,
+    SensorFirmwareIntegrity = 0x21,
+};
+
+static void
+poll_write(void *context, uint32_t reg, uint32_t value)
+{
+    const GeniIo *io = context;
+    /* The firmware left the master IRQ unrouted. Poll the status instead. */
+    if (reg != GENI_SE_IRQ_EN) {
+        io->write(io->ctx, reg, value);
+    }
+}
+
+static uint32_t
+poll_read(void *context, uint32_t reg)
+{
+    const GeniIo *io = context;
+    return io->read(io->ctx, reg);
+}
+
+static int
+read_byte(GeniI2c *bus, void (*wait_us)(int), uint8_t reg, uint8_t *byte)
+{
+    if (geni_i2c_start_read(bus, reg) != 0) {
+        return GeniFailed;
+    }
+    /* One transfer window, followed by bounded cancel and abort windows. */
+    for (unsigned window = 0; window < 3; ++window) {
+        for (unsigned elapsed = 0; elapsed < 20000; elapsed += 10) {
+            int state = geni_i2c_poll(bus);
+            if (state != GeniPending) {
+                if (state == GeniDone) {
+                    *byte = bus->data;
+                }
+                return state;
+            }
+            wait_us(10);
+        }
+        geni_i2c_timeout(bus);
+    }
+    return GeniFailed;
+}
+
+int
+sm8250_touch_read_chip(const GeniIo *io, void (*wait_us)(int), Sm8250TouchResult *result)
+{
+    *result = (Sm8250TouchResult){0};
+    if ((io->read(io->ctx, GeniStatus) & GeniCommandActive) ||
+        (io->read(io->ctx, GENI_SE_IRQ_EN) & GENI_SE_M_IRQ_EN) ||
+        io->read(io->ctx, GeniGsiEventEnable) ||
+        io->read(io->ctx, GENI_M_IRQ_STATUS) ||
+        (io->read(io->ctx, GeniTxFifoStatus) & 0xfffffffu) ||
+        (io->read(io->ctx, GENI_RX_FIFO_STATUS) & 0x1ffffffu) ||
+        io->read(io->ctx, GENI_TX_WATERMARK)) {
+        return SmTouchEngineBusy;
+    }
+
+    /* Save the controller configuration changed by the upstream polling core. */
+    static const uint32_t configuration[] = {
+        GENI_DMA_MODE, GENI_TX_PACK0, GENI_TX_PACK1, GENI_RX_PACK0,
+        GENI_RX_PACK1, GENI_BYTE_GRAN, GENI_TX_LEN, GENI_RX_LEN, GENI_M_IRQ_EN,
+    };
+    uint32_t saved[sizeof(configuration) / sizeof(configuration[0])];
+    for (unsigned i = 0; i < sizeof(saved) / sizeof(saved[0]); ++i) {
+        saved[i] = io->read(io->ctx, configuration[i]);
+    }
+
+    GeniI2c bus;
+    const GeniIo polling = {poll_read, poll_write, (void *)io};
+    if (geni_i2c_prepare(&bus, &polling, SensorAddress, &result->config) != 0) {
+        return SmTouchEngineUnavailable;
+    }
+    result->reg = SensorBootStatus;
+    int state = read_byte(&bus, wait_us, result->reg, &result->boot);
+    if (state == GeniDone) {
+        if (io->read(io->ctx, GeniStatus) & GeniCommandActive) {
+            return SmTouchEngineStillActive;
+        }
+        result->reg = SensorFirmwareIntegrity;
+        state = read_byte(&bus, wait_us, result->reg, &result->integrity);
+    }
+    result->error = bus.error;
+    result->irq_status = bus.error_status;
+    if (io->read(io->ctx, GeniStatus) & GeniCommandActive) {
+        return SmTouchEngineStillActive;
+    }
+    for (unsigned i = 0; i < sizeof(saved) / sizeof(saved[0]); ++i) {
+        io->write(io->ctx, configuration[i], saved[i]);
+    }
+    return state == GeniDone ? SmTouchReadComplete : SmTouchTransferFailed;
+}
