+
+static int
+smufs_data_seed_matches(uint32_t device,uint64_t bytes,const uint8_t hash[32],
+    uint32_t os_device,uint32_t system_device)
+{
+ return device!=0xffffffffU && device!=os_device && device!=system_device &&
