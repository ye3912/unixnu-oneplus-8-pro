+/* Board-only writable RAM Data. Initial seed identity is independent of root
+ * authentication; mutable Data does not claim signed immutable integrity.
+ */
+extern int native_ram_block_volume_seed(const char *,dev_t *,char *,size_t,uint64_t *,uint64_t *,uint8_t[32]);
+extern volatile uint32_t native_data_persist_state;
+static const char smufs_data_uuid[]="8360D3EE-5075-4532-8DE3-138DC6044254";
+static const uint8_t smufs_data_expected_hash[32]={0xd1,0xf8,0xb4,0x8b,0x90,0x13,0x4f,0xd4,0x65,0xab,0xf2,0x85,0x8d,0xdd,0x39,0x33,0xa6,0x89,0xf0,0xd2,0xf8,0x9e,0x1f,0x9a,0xab,0x8f,0x6a,0x8c,0x58,0x48,0x52,0x72};
