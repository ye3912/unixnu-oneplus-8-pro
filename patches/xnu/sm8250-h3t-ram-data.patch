+ if(!d)goto done;
+ error=EAUTH;
+ if(proc_getpid(current_proc())!=1 || !scratch || scratch>~(uint64_t)0-0x600 ||
+    rootvnode!=cache->original_root || !smufs_cache_root_valid() || !cache->readonly ||
+    !cache->system_mount || !(vfs_flags(cache->system_mount)&MNT_RDONLY) ||
+    !smufs_cache_integrity_valid(cache,1) || native_data_persist_state)goto done;
+ if(!native_ram_block_volume_seed(smufs_data_uuid,&selected,smufs_data_state.device,
+      sizeof(smufs_data_state.device),&base,&bytes,d->hash)){error=ENOENT;goto done;}
+ smufs_data_state.selected=(uint32_t)selected;smufs_data_state.bytes=bytes;
+ if(!smufs_data_seed_matches((uint32_t)selected,bytes,d->hash,(uint32_t)rootdev,cache->selected) ||
+    strncmp(smufs_data_state.device,"/dev/disk",9) || native_data_persist_state){error=EAUTH;goto done;}
+ smufs_data_state.seed_ok=1;smufs_data_state.stage=2;
+ error=vnode_lookup("/private/var",0,&data_root,vfs_context_current());
+ if(error)goto done;
+ if(vnode_vtype(data_root)!=VDIR || vnode_mount(data_root)!=vnode_mount(rootvnode)){error=EBUSY;goto done;}
+ vnode_put(data_root);data_root=NULLVP;
+ user64_addr_t spec=scratch+0x160;
+ uint16_t mode=1;uint32_t anonymous=99;
+ memcpy(d->payload,&spec,sizeof(spec));memcpy(d->payload+16,&mode,sizeof(mode));
+ memcpy(d->payload+0x144,&anonymous,4);memcpy(d->payload+0x148,&anonymous,4);
+ struct mount_args request={.type=scratch+0x100,.path=scratch+0x120,.flags=0,.data=scratch+0x200};
+ int32_t result=0;
+ if((error=copyout("apfs",request.type,5)) ||
+    (error=copyout("/private/var",request.path,sizeof("/private/var"))) ||
+    (error=copyout(smufs_data_state.device,spec,strlen(smufs_data_state.device)+1)) ||
+    (error=copyout(d->payload,request.data,sizeof(d->payload))))goto done;
+ smufs_data_state.stage=3;smufs_data_state.mount_enter=1;
+ error=mount(current_proc(),&request,&result);smufs_data_state.mount_return=1;
+ if(error)goto done;
+ smufs_data_state.stage=4;
+ error=vnode_lookup("/private/var",0,&data_root,vfs_context_current());
+ if(error)goto done;
+ data_mount=vnode_mount(data_root);
+ if(!data_mount){error=EINVAL;goto done;}
+ vnode_t device=vfs_devvp(data_mount);
+ smufs_data_state.mounted=device?(uint32_t)vnode_specrdev(device):0xffffffffU;
+ if(device)vnode_put(device);
+ smufs_data_state.readonly=(vfs_flags(data_mount)&MNT_RDONLY)!=0;
+ smufs_data_state.apfs=!strcmp(vfs_statfs(data_mount)->f_fstypename,"apfs");
+ smufs_data_state.root_same=rootvnode==cache->original_root;
+ if(smufs_data_state.readonly || !smufs_data_state.apfs || smufs_data_state.mounted!=(uint32_t)selected ||
+    data_mount==cache->system_mount || data_mount==vnode_mount(rootvnode) ||
+    !smufs_data_state.root_same || !smufs_cache_root_valid() ||
+    !(vfs_flags(cache->system_mount)&MNT_RDONLY) || !smufs_cache_integrity_valid(cache,1)){
+  error=EAUTH;goto done;
+ }
+ smufs_data_state.rebound=native_ram_block_volume_seed(smufs_data_uuid,&fresh,d->postpath,
+    sizeof(d->postpath),&postbase,&postbytes,d->posthash) && fresh==selected && postbytes==bytes &&
+    !strcmp(d->postpath,smufs_data_state.device) &&
+    smufs_data_seed_matches((uint32_t)fresh,postbytes,d->posthash,(uint32_t)rootdev,cache->selected);
+ if(!smufs_data_state.rebound || native_data_persist_state){error=EAUTH;goto done;}
+ error=vnode_lookup("/var/db/timezone",0,&timezone,vfs_context_current());
+ if(error)goto done;
+ smufs_data_state.path_bound=vnode_vtype(timezone)==VDIR && vnode_mount(timezone)==data_mount;
+ if(!smufs_data_state.path_bound){error=EXDEV;goto done;}
+ smufs_data_state.stage=5;
+done:
+ if(timezone)vnode_put(timezone);
+ if(data_root)vnode_put(data_root);
+ if(d)kfree_data(d,sizeof(*d));
+ smufs_data_state.error=error;
+ if(!error)printf("SMUFS data-h3t prepared %s",smufs_data_note());
+ return error;
+}
