+     (unsigned long long)smufs_data_state.bytes,native_data_persist_state==0,
+     smufs_data_state.selected,smufs_data_state.mounted,smufs_data_state.readonly,smufs_data_state.apfs,
+     smufs_data_state.root_same,smufs_data_state.path_bound,smufs_data_state.mount_enter,
+     smufs_data_state.mount_return,smufs_data_state.device);
+ return note;
+}
