+extern int sm8250_alioth_metal_register(void);
+
+static void
+sm8250_metal_addon_prepare(uint64_t scratch, vfs_context_t ctx)
+{
+    static const char source[] = "/private/var/ngpu/addons";
+    static const char target[] = "/System/Library/Extensions";
+    static const char *const entries[] = {
+        "/System/Library/Extensions/AGXMetalA10.bundle",
+        "/System/Library/Extensions/NativeAdrenoMetal.bundle/Info.plist",
+    };
+    unsigned stage = 1;
+    int error = kernel_mount("bindfs", NULLVP, NULLVP, target, (void *)source, sizeof(source),
+        MNT_RDONLY | MNT_UNION | MNT_NOSUID | MNT_NODEV, 0, ctx);
+    if (!error) {
+        stage = 2;
+        for (unsigned i = 0; !error && i < sizeof(entries) / sizeof(entries[0]); ++i) {
+            vnode_t entry = NULLVP;
+            error = vnode_lookup(entries[i], VNODE_LOOKUP_NOFOLLOW, &entry, ctx);
+            if (!error) vnode_put(entry);
+        }
+        if (!error) {
+            stage = 3;
+            error = sm8250_alioth_metal_register();
+        }
+        if (error) {
+            struct unmount_args request = {.path = scratch + 0xe00, .flags = 0};
+            int32_t result = 0;
+            int rollback = copyout(target, request.path, sizeof(target));
+            if (!rollback) rollback = unmount(current_proc(), &request, &result);
+            printf("GPU59 addon rollback=%d\n", rollback);
+        } else {
+            stage = 4;
+        }
+    }
+    printf("GPU59 mode12 result status=%x stage=%u\n", error, stage);
+}
