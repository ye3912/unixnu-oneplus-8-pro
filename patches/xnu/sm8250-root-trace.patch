+
+enum SmUfsRootTraceEvent {
+	SMRT_AUTOCONF_ENTER = 1, SMRT_KMINIT_ENTER, SMRT_KMINIT_RETURN, SMRT_PSEUDO_DONE,
+	SMRT_IOBSD_ENTER, SMRT_IOBSD_RETURN, SMRT_SETCONF_ENTER, SMRT_SETCONF_RETURN,
+	SMRT_FIND_ENTER, SMRT_RESOURCE_ENTER, SMRT_RESOURCE_RETURN, SMRT_INPUTS,
+	SMRT_MATCH_SOURCE, SMRT_QUIET_ENTER, SMRT_QUIET_RETURN, SMRT_ROOT_WAIT_ENTER,
+	SMRT_ROOT_WAIT_RETURN, SMRT_MEDIA_RESOLVED, SMRT_SELECTED, SMRT_ROOTMEDIA_ENTER,
+	SMRT_ROOTMEDIA_RETURN, SMRT_FIND_RETURN, SMRT_FIND_CALL_RETURN, SMRT_FALLBACK,
+	SMRT_MOUNT_ENTER, SMRT_MOUNT_RETURN, SMRT_SECURE_ENTER, SMRT_SECURE_RETURN,
+	SMRT_VFSROOT_ENTER, SMRT_VFSROOT_RETURN, SMRT_ROOT_PUBLISHED,
+	SMRT_AUTH_ENTER, SMRT_AUTH_RETURN, SMRT_DEVFS_ENTER, SMRT_DEVFS_RETURN,
+	SMRT_BSD_ENTER, SMRT_BSD_RETURN, SMRT_IOBSD_PUBLISH_ENTER, SMRT_IOBSD_PUBLISH_RETURN,
+	SMRT_BSD_PROPERTIES
+};
+enum SmUfsRootTraceKind { SMRT_NONE = 0, SMRT_KERN = 1, SMRT_ERRNO = 2, SMRT_PRESENT = 3, SMRT_FLAGS = 4 };
+enum SmUfsRootTraceMatch { SMRT_MATCH_UNKNOWN = 0, SMRT_MATCH_CHOSEN = 1,
+	SMRT_MATCH_DT_UUID = 2, SMRT_MATCH_MEMORY = 3, SMRT_MATCH_NETWORK = 4,
+	SMRT_MATCH_ARG_UUID = 5, SMRT_MATCH_BSDNAME = 6, SMRT_MATCH_HFS = 7 };
+enum SmUfsRootTraceInput { SMRT_INPUT_RD = 1, SMRT_INPUT_ROOTDEV = 2,
+	SMRT_INPUT_CHOSEN = 4, SMRT_INPUT_DT_UUID = 8, SMRT_INPUT_BOOT_UUID = 16 };
