+/* 21H461 BackBoardServices __BKSDisplayGetMainScreenInfo. Match only the
+ * original SpringBoard executable and its main thread. No payload is read. */
+static bool
+pk31_screen_request(mach_msg_id_t msgid)
+{
+	static const unsigned char springboard[16] = {
+		0x97,0x49,0x8f,0x96,0xfa,0x26,0x38,0xc9,0xb5,0xe5,0xf8,0xa2,0xae,0x58,0x31,0x06
+	};
+	if (msgid != 0x5b9173 || !(current_thread()->thread_tag & THREAD_TAG_MAINTHREAD)) {
+		return false;
+	}
+	struct proc *proc = get_bsdtask_info(current_task());
+	unsigned char uuid[16] = {};
+	if (!proc) {
+		return false;
+	}
+	proc_getexecutableuuid(proc, uuid, sizeof(uuid));
+	return memcmp(uuid, springboard, sizeof(uuid)) == 0;
 }
 
