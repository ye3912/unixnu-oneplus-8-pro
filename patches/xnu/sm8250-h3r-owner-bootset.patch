+/* SMUFS owner metadata is derived only after both actual readonly mounts and
+ * policies pass. It does not assert Apple secure-boot/firmware personalization.
+ * Sole caller is PID1 preparation before any original user program is executed.
+ */
+#if !DEVELOPMENT && !DEBUG
+#error SMUFS owner image-set metadata requires a development kernel
+#endif
+extern "C" uint32_t smufs_owner_bootset_digest(uint32_t,uint32_t,int32_t,uint64_t,uint8_t[48]);
+extern "C" {
+int native_smufs_bootset_status=-1;
+uint8_t native_smufs_bootset_hash[48];
+}
+static const char smufs_bootset_domain[]="SMUFS.OwnerBootSet.v1";
+static const char smufs_bootset_policy[]="os=rsa3072-sha256;systemos=kernel-sha256-pin;not-apple-personalization";
+extern "C" __attribute__((noinline)) int
+native_smufs_bootset_publish(uint32_t root,uint32_t system,int32_t apple_error,uint64_t media)
+{
+ int expected=-1;
+ if(!__atomic_compare_exchange_n(&native_smufs_bootset_status,&expected,-2,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE))return 0;
+ uint8_t digest[48];
+ if(!smufs_owner_bootset_digest(root,system,apple_error,media,digest)){
+  __atomic_store_n(&native_smufs_bootset_status,1,__ATOMIC_RELEASE);return 0;}
+ IORegistryEntry *chosen=IORegistryEntry::fromPath("/chosen",gIODTPlane);
+ if(!chosen){__atomic_store_n(&native_smufs_bootset_status,2,__ATOMIC_RELEASE);return 0;}
+ // Existing firmware or owner metadata is a conflict, even if bytes match.
+ if(chosen->getProperty("boot-manifest-hash")||chosen->getProperty("owner-boot-manifest-domain")||chosen->getProperty("owner-boot-manifest-policy")){
+  chosen->release();__atomic_store_n(&native_smufs_bootset_status,3,__ATOMIC_RELEASE);return 0;}
+ OSData *value=OSData::withBytes(digest,sizeof(digest));
+ OSData *tag=OSData::withBytes(smufs_bootset_domain,sizeof(smufs_bootset_domain));
+ OSData *policy=OSData::withBytes(smufs_bootset_policy,sizeof(smufs_bootset_policy));
+ if(!value||!tag||!policy){OSSafeReleaseNULL(value);OSSafeReleaseNULL(tag);OSSafeReleaseNULL(policy);chosen->release();
+  __atomic_store_n(&native_smufs_bootset_status,4,__ATOMIC_RELEASE);return 0;}
+ bool tagged=chosen->setProperty("owner-boot-manifest-domain",tag);
+ bool described=tagged&&chosen->setProperty("owner-boot-manifest-policy",policy);
+ bool published=described&&chosen->setProperty("boot-manifest-hash",value);
+ uint8_t actual[48];size_t actualSize=sizeof(actual);
+ bool result=published&&chosen->getProperty("owner-boot-manifest-domain")==tag&&chosen->getProperty("owner-boot-manifest-policy")==policy&&
+     chosen->getProperty("boot-manifest-hash")==value&&IOGetBootManifestHash(reinterpret_cast<char *>(actual),&actualSize)&&
+     actualSize==sizeof(digest)&&!memcmp(actual,digest,sizeof(digest));
+ if(result)memcpy(native_smufs_bootset_hash,actual,sizeof(actual));
+ else{
+  // Roll back only properties still owned by this attempt.
+  if(published&&chosen->getProperty("boot-manifest-hash")==value)chosen->removeProperty("boot-manifest-hash");
+  if(described&&chosen->getProperty("owner-boot-manifest-policy")==policy)chosen->removeProperty("owner-boot-manifest-policy");
+  if(tagged&&chosen->getProperty("owner-boot-manifest-domain")==tag)chosen->removeProperty("owner-boot-manifest-domain");
+ }
+ OSSafeReleaseNULL(value);OSSafeReleaseNULL(tag);OSSafeReleaseNULL(policy);chosen->release();
+ __atomic_store_n(&native_smufs_bootset_status,result?0:5,__ATOMIC_RELEASE);return result;
+}
+extern "C" __attribute__((noinline)) const char *
+native_smufs_bootset_note(void)
+{
+ static char note[208];char hex[97];static const char digits[]="0123456789abcdef";
+ int status=__atomic_load_n(&native_smufs_bootset_status,__ATOMIC_ACQUIRE);
+ for(unsigned i=0;i<48;++i){uint8_t b=status==0?native_smufs_bootset_hash[i]:0;hex[2*i]=digits[b>>4];hex[2*i+1]=digits[b&15];}hex[96]=0;
+ snprintf(note,sizeof(note),"bootset owner%u status%d firmware0 sha384%s\n",status==0,status,hex);return note;
+}
+
 #if defined(XNU_OWNER_BOOT_MANIFEST) && XNU_OWNER_BOOT_MANIFEST
 #if !DEVELOPMENT && !DEBUG
 #error Owner image-set metadata is an offline development instrument
