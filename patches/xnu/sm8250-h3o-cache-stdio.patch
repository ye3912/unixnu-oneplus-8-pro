+/* H3O: keep the cache directory away from libignition-owned fd 0/1/2.
+ * Only the verified mode3 PID1 preparation calls this before the original exec.
+ * Refuse any existing standard descriptor; never overwrite unknown ownership.
+ */
+__attribute__((noinline)) int
+native_smufs_cache_prepare_stdio(void)
+{
+ if(!native_smufs_cache_io_enabled())return EPERM;
+ proc_t p=current_proc();vfs_context_t ctx=vfs_context_current();
+ for(int i=0;i<3;++i){
+  struct fileproc *fp=NULL;int error=fp_lookup(p,i,&fp,0);
+  if(!error){(void)fp_drop(p,i,fp,0);return EBUSY;}
+  if(error!=EBADF)return error;
+ }
+ int opened[3]={-1,-1,-1};int error=0;
+ for(int i=0;i<3;++i){
+  int32_t fd=-1;
+  error=openat_internal(ctx,(user_addr_t)"/dev/null",(i?O_WRONLY:O_RDONLY)|O_NOCTTY,
+      0,AT_FDCWD,UIO_SYSSPACE,&fd);
+  if(error)goto fail;
+  opened[i]=fd;
+  if(fd!=i){error=EBUSY;goto fail;}
+ }
+ return 0;
+fail:
+ /* Any failure stops init. Roll back only descriptors created by this call. */
+ for(int i=2;i>=0;--i)if(opened[i]>=0)(void)close_nocancel(p,vfs_context_ucred(ctx),opened[i]);
+ return error;
+}
