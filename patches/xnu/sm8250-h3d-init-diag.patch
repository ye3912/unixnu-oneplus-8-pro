+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef SMUFS_INIT_TRACE_H
+#define SMUFS_INIT_TRACE_H
+#include <stdint.h>
+struct SmUfsInitTrace {
+ uint32_t enabled,attempts,stage,scratch,exec_enter,exec_return;
+ int32_t alloc_error,exec_error;
+ uint32_t lookup_enter,lookup_return; int32_t lookup_error;
+ uint32_t permission_return; int32_t permission_error;
+ uint32_t read_enter,read_return; int32_t read_error; uint32_t magic;
+ uint32_t activate_enter,activate_return; int32_t activate_error;
+ uint32_t signature_enter,signature_return; int32_t signature_error;
+ char path[128];
+};
+extern struct SmUfsInitTrace native_smufs_init_trace;
+__attribute__((noreturn)) void native_smufs_init_diag(const char *phase,int error);
+#endif
