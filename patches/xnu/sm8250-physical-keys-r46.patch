--- /dev/null
+++ b/bsd/dev/Sm8250Keys.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <vm/memory_types.h>
+
+#define KEBAB_KEYS_KERNEL 1
+#include "KebabKeys.h"
+#include "kebab_spmi_bus.h"
+
+extern void IOSleep(unsigned milliseconds);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+extern void thread_terminate_self(void);
+extern bool sm8250_buttons_publish(uint32_t mask);
+void sm8250_keys_start(void);
+
+enum {KeyPollMs = 16, InvalidLimit = 8, SpmiCoreSpan = 0x2000};
+
+struct key_sources {
+    uint32_t pon, up, down;
+    bool up_enabled, down_enabled;
+};
+
+static bool
+key_read(uint32_t apid, uint32_t reg, uint8_t *value)
+{
+    return kebab_spmi_obs_read_ex(apid, 0, reg, 1, false, true, value) == 0;
+}
+
+static bool
+gpio_ready(uint32_t apid, uint32_t base)
+{
+    uint8_t type = 0, mode = 0, pull = 0, enable = 0;
+    const bool readable = key_read(apid, base + 4, &type) &&
+        key_read(apid, base + 0x40, &mode) && key_read(apid, base + 0x42, &pull) &&
+        key_read(apid, base + 0x46, &enable);
+    const bool ok = readable && type == KEBAB_KEYS_GPIO_TYPE &&
+        !(mode & 3) && (pull & 7) < 4 && (enable & 0x80);
+    printf("KEY46 pin base=%x apid=%x type=%x mode=%x pull=%x enable=%x valid=%u\n",
+        base, apid, type, mode, pull, enable, ok);
+    return ok;
+}
+
+static bool
+read_sample(const struct key_sources *keys, kebab_keys_sample *sample)
+{
+    /* Unconfigured active-low pins are represented as released. RESIN remains physical. */
+    *sample = (kebab_keys_sample){.gpio_up_rt = 1, .gpio_down_rt = 1};
+    sample->read_ok = key_read(keys->pon, KEBAB_KEYS_PON_RT_STS, &sample->pon_rt) &&
+        key_read(keys->up, KEBAB_KEYS_GPIO_IDENT, &sample->gpio_ident) &&
+        (!keys->up_enabled || key_read(keys->up, KEBAB_KEYS_GPIO_UP_RT_STS, &sample->gpio_up_rt)) &&
+        (!keys->down_enabled || key_read(keys->down, KEBAB_KEYS_GPIO_DOWN_RT_STS, &sample->gpio_down_rt));
+    return kebab_keys_classify(sample) == KEBAB_KEYS_SAMPLE_OK;
+}
+
+static void
+sample_keys(const struct key_sources *keys)
+{
+    kebab_keys_sample sample;
+    if (!read_sample(keys, &sample)) {
+        printf("KEY46 failed stage=initial-sample raw=%02x/%02x/%02x/%02x\n",
+            sample.pon_rt, sample.gpio_up_rt, sample.gpio_down_rt, sample.gpio_ident);
+        return;
+    }
+    kebab_keys_state state;
+    kebab_keys_reset(&state);
+    unsigned pressed = 0, released = 0, invalid = 0, reported_mask = 0;
+    bool complete = false;
+    printf("KEY46 ready gpio6=%u gpio7=%u raw=%02x/%02x/%02x/%02x\n", keys->up_enabled, keys->down_enabled,
+        sample.pon_rt, sample.gpio_up_rt, sample.gpio_down_rt, sample.gpio_ident);
+    for (;;) {
+        if (read_sample(keys, &sample)) {
+            invalid = 0;
+            uint64_t ns;
+            absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+            kebab_keys_event events[KEBAB_KEYS_MAX_EVENTS];
+            (void)kebab_keys_feed(&state, &sample, ns, events);
+        } else if (invalid < InvalidLimit && ++invalid == InvalidLimit) {
+            kebab_keys_reset(&state);
+            printf("KEY46 sample lost; release active HID keys\n");
+        }
+
+        unsigned mask = 0;
+        for (unsigned i = 0; i < KEBAB_KEYS_KEY_COUNT; ++i) {
+            if (kebab_keys_pressed(&state, i)) mask |= 1u << (i + 1);
+        }
+        if (mask != reported_mask && sm8250_buttons_publish(mask)) {
+            const unsigned changed = mask ^ reported_mask;
+            reported_mask = mask;
+            if (invalid == 0) {
+                pressed |= changed & mask;
+                released |= changed & ~mask & pressed;
+            }
+            if (!complete && released == 0xe) {
+                printf("KEY46 complete power volume-up volume-down\n");
+                complete = true;
+            }
+        }
+        IOSleep(KeyPollMs);
+    }
+}
+
+static void
+keys_thread(void *unused, wait_result_t result)
+{
+    (void)unused;
+    (void)result;
+    if (spmi.core || spmi.cnfg || spmi.obsrvr) {
+        printf("KEY46 failed stage=arbiter-in-use\n");
+        thread_terminate_self();
+        return;
+    }
+    /* Touch power released these windows before publishing the shared HID device. */
+    spmi.core = ml_io_map_unmappable(KEBAB_SPMI_CORE_PA, SpmiCoreSpan, VM_WIMG_IO);
+    spmi.cnfg = ml_io_map_unmappable(KEBAB_SPMI_CNFG_PA, KEBAB_SPMI_CNFG_SIZE, VM_WIMG_IO);
+    spmi.obsrvr = ml_io_map_unmappable(KEBAB_SPMI_OBSRV_PA, KEBAB_SPMI_OBSRV_SIZE, VM_WIMG_IO);
+    struct key_sources keys = {0};
+    uint8_t subtype = 0;
+    if (!spmi.core || !spmi.cnfg || !spmi.obsrvr) {
+        printf("KEY46 failed stage=map\n");
+    } else if (!kebab_spmi_version_known(kebab_spmi_rd(spmi.core, KEBAB_SPMI_VERSION)) ||
+        kebab_spmi_reader(KEBAB_SPMI_PON_PPID, &keys.pon) != 0 ||
+        kebab_spmi_reader(KEBAB_KEYS_GPIO_UP_RT_STS >> 8, &keys.up) != 0 ||
+        kebab_spmi_reader(KEBAB_KEYS_GPIO_DOWN_RT_STS >> 8, &keys.down) != 0 ||
+        !key_read(keys.pon, KEBAB_SPMI_PON_SUBTYPE, &subtype) || subtype != 4) {
+        printf("KEY46 failed stage=identity pon=%x up=%x down=%x subtype=%x\n",
+            keys.pon, keys.up, keys.down, subtype);
+    } else {
+        keys.up_enabled = gpio_ready(keys.up, KEBAB_KEYS_GPIO_UP_RT_STS & ~0xffu);
+        keys.down_enabled = gpio_ready(keys.down, KEBAB_KEYS_GPIO_DOWN_RT_STS & ~0xffu);
+        sample_keys(&keys);
+    }
+    if (spmi.obsrvr) ml_io_unmap(spmi.obsrvr, KEBAB_SPMI_OBSRV_SIZE);
+    if (spmi.cnfg) ml_io_unmap(spmi.cnfg, KEBAB_SPMI_CNFG_SIZE);
+    if (spmi.core) ml_io_unmap(spmi.core, SpmiCoreSpan);
+    spmi.obsrvr = spmi.cnfg = spmi.core = 0;
+    thread_terminate_self();
+}
+
+void
+sm8250_keys_start(void)
+{
+    static bool started;
+    unsigned enabled = 0;
+    if (started || !PE_parse_boot_argn("sheng-buttons", &enabled, sizeof(enabled)) || enabled != 1) return;
+    started = true;
+    thread_t worker;
+    kern_return_t status = kernel_thread_start(keys_thread, NULL, &worker);
+    if (status == KERN_SUCCESS) {
+        thread_deallocate(worker);
+    } else {
+        printf("KEY46 failed stage=thread status=%d\n", status);
+    }
+}
--- /dev/null
+++ b/bsd/dev/KebabKeys.c
@@ -0,0 +1,209 @@
+#define KEBAB_KEYS_KERNEL 1
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/*
+ * The PM8150 key decode and debounce state machine.
+ *
+ * The register facts, the GPIO active-low convention and the two possible
+ * volume-down paths (PM8150 GPIO7 and PON RESIN) are documented once in
+ * KebabKeys.h.  This file is deliberately free of MMIO, SPMI and kernel
+ * objects: bsd/dev/kebab_keys.c feeds it four bytes and publishes what it
+ * returns, and KebabKeysHostTests.c drives the same functions.
+ *
+ * Two rules decide most of the behaviour:
+ *
+ *   - a sample that is all zero is a silent bus, not "every key held".  The
+ *     GPIO level bit is inverted (active low), so a naive decoder would read
+ *     0x00 as both volume keys pressed.  The identity byte (0x0c504, always
+ *     0x10 on a live PM8150 GPIO page) is part of the sample for exactly this
+ *     reason: if it is zero as well, nothing was read.
+ *   - a transfer that failed, or a page that is not the expected peripheral,
+ *     changes no state.  A read error is "no observation", not a release.
+ */
+#include "KebabKeys.h"
+
+void
+kebab_keys_reset(kebab_keys_state *state)
+{
+	unsigned k;
+
+	if (state == NULL) {
+		return;
+	}
+	memset(state, 0, sizeof(*state));
+	for (k = 0; k < KEBAB_KEYS_KEY_COUNT; k++) {
+		state->key[k].usable = 1;
+	}
+}
+
+void
+kebab_keys_enable(kebab_keys_state *state, unsigned key, int usable)
+{
+	kebab_keys_key *k;
+
+	if (state == NULL || key >= KEBAB_KEYS_KEY_COUNT) {
+		return;
+	}
+	k = &state->key[key];
+	k->usable = usable != 0;
+	if (!k->usable) {
+		/* Callers enable before feeding; never leave a reported hold. */
+		k->down = 0;
+		k->candidate = 0;
+		k->candidate_count = 0;
+		k->held_samples = 0;
+		k->pressed_since_ns = 0;
+		k->stuck = 0;
+	}
+}
+
+const char *
+kebab_keys_name(unsigned key)
+{
+	switch (key) {
+	case KEBAB_KEYS_KEY_POWER:
+		return "power";
+	case KEBAB_KEYS_KEY_VOLUME_UP:
+		return "volume-up";
+	case KEBAB_KEYS_KEY_VOLUME_DOWN:
+		return "volume-down";
+	default:
+		return "unknown";
+	}
+}
+
+/*
+ * Decide what one look at the four registers means.  The all-zero test comes
+ * before the identity test so a dead bus is reported as a dead bus, not as a
+ * peripheral that identified itself as zero.
+ */
+kebab_keys_sample_status
+kebab_keys_classify(const kebab_keys_sample *sample)
+{
+	if (sample == NULL || !sample->read_ok) {
+		return KEBAB_KEYS_SAMPLE_READ_ERROR;
+	}
+	if (sample->pon_rt == 0 && sample->gpio_up_rt == 0 &&
+	    sample->gpio_down_rt == 0 && sample->gpio_ident == 0) {
+		return KEBAB_KEYS_SAMPLE_ZERO;
+	}
+	if (sample->gpio_ident != KEBAB_KEYS_GPIO_TYPE) {
+		return KEBAB_KEYS_SAMPLE_BAD_IDENTITY;
+	}
+	return KEBAB_KEYS_SAMPLE_OK;
+}
+
+/*
+ * Feed one sample.  Returns the number of accepted transitions (0 to 3) and
+ * fills events in key order.  The state does not change on an invalid sample.
+ *
+ * Debounce is two consecutive agreeing samples, which is 32 ms at the default
+ * 16 ms poll: longer than the vendor gpio-keys debounce-interval of 15 ms and
+ * than the PON block's 15.6 ms hardware debounce.  A bouncy line therefore
+ * produces no event at all until it settles.
+ *
+ * The reported state starts released.  A key already held on the first
+ * believed sample is reported pressed after the same two samples, and then
+ * once more only when it is released; the stuck flag fires after ten seconds
+ * of a continuous hold so the log can say that the key is not coming back.
+ */
+size_t
+kebab_keys_feed(kebab_keys_state *state, const kebab_keys_sample *sample,
+    uint64_t now_ns, kebab_keys_event events[KEBAB_KEYS_MAX_EVENTS])
+{
+	uint8_t raw[KEBAB_KEYS_KEY_COUNT];
+	int resin;
+	size_t count = 0;
+	unsigned k;
+
+	if (state == NULL || sample == NULL || events == NULL) {
+		return 0;
+	}
+	if (kebab_keys_classify(sample) != KEBAB_KEYS_SAMPLE_OK) {
+		state->invalid++;
+		return 0;
+	}
+	state->samples++;
+
+	/*
+	 * PON RT_STS bits are already asserted-high.  PM8150 GPIO RT_STS bit 0
+	 * is the pin level and the vendor gpio_keys node marks both GPIOs
+	 * GPIO_ACTIVE_LOW, so a clear level bit is a press.
+	 */
+	resin = (sample->pon_rt & KEBAB_KEYS_PON_RESIN) != 0;
+	raw[KEBAB_KEYS_KEY_POWER] =
+	    (sample->pon_rt & KEBAB_KEYS_PON_KPDPWR) != 0;
+	raw[KEBAB_KEYS_KEY_VOLUME_UP] =
+	    (sample->gpio_up_rt & KEBAB_KEYS_GPIO_LEVEL) == 0;
+	raw[KEBAB_KEYS_KEY_VOLUME_DOWN] =
+	    ((sample->gpio_down_rt & KEBAB_KEYS_GPIO_LEVEL) == 0) || resin;
+
+	for (k = 0; k < KEBAB_KEYS_KEY_COUNT; k++) {
+		kebab_keys_key *key = &state->key[k];
+		kebab_keys_event *event;
+
+		if (!key->usable) {
+			continue;
+		}
+		if (raw[k]) {
+			key->held_samples++;
+			if (key->held_samples == 1) {
+				key->pressed_since_ns = now_ns;
+			}
+			if (!key->stuck && now_ns >= key->pressed_since_ns &&
+			    now_ns - key->pressed_since_ns >=
+			    KEBAB_KEYS_STUCK_NS) {
+				key->stuck = 1;
+			}
+		} else {
+			key->held_samples = 0;
+			key->pressed_since_ns = 0;
+			key->stuck = 0;
+		}
+
+		if (raw[k] == key->down) {
+			key->candidate = key->down;
+			key->candidate_count = 0;
+			continue;
+		}
+		if (key->candidate_count != 0 && key->candidate == raw[k]) {
+			key->candidate_count++;
+		} else {
+			key->candidate = raw[k];
+			key->candidate_count = 1;
+		}
+		if (key->candidate_count < KEBAB_KEYS_DEBOUNCE_SAMPLES) {
+			continue;
+		}
+
+		key->down = raw[k];
+		key->candidate = key->down;
+		key->candidate_count = 0;
+		if (key->down) {
+			key->presses++;
+		} else {
+			key->releases++;
+		}
+
+		event = &events[count++];
+		event->key = (uint8_t)k;
+		event->pressed = key->down ? 1 : 0;
+		event->flags = (k == KEBAB_KEYS_KEY_VOLUME_DOWN && resin) ?
+		    KEBAB_KEYS_EVENT_RESIN : 0;
+		event->raw_pon = sample->pon_rt;
+		event->raw_gpio_up = sample->gpio_up_rt;
+		event->raw_gpio_down = sample->gpio_down_rt;
+		event->raw_ident = sample->gpio_ident;
+		event->seq = state->seq++;
+		event->timestamp_ns = now_ns;
+	}
+	return count;
+}
+
+int
+kebab_keys_pressed(const kebab_keys_state *state, unsigned key)
+{
+	if (state == NULL || key >= KEBAB_KEYS_KEY_COUNT) {
+		return 0;
+	}
+	return state->key[key].usable && state->key[key].down;
+}
