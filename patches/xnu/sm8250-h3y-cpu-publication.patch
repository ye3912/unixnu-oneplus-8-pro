+/* Board publication policy for the selected ArmCpu9066b53 implementation.
+ * GF0168 keeps unselected CPUs in the DT but withholds their IOService nub.
+ * ArmCpu also rejects nonboot CPUs when sheng-smp=0 and logical slots>=8.
+ * Mirror that selection before registration; never clear a busy reference.
+ */
+static unsigned smufs_cpu_eligible, smufs_cpu_withheld, smufs_cpu_invalid;
+static unsigned smufs_cpu_smp;
+static int smufs_cpu_boot = -1;
+extern "C" __attribute__((noinline)) bool
+native_smufs_cpu_nub_selected(int logical)
+{
+    unsigned smp = 0;
+    PE_parse_boot_argn("sheng-smp", &smp, sizeof(smp));
+    int boot = ml_get_boot_cpu_number();
+    __atomic_store_n(&smufs_cpu_smp, smp, __ATOMIC_RELAXED);
+    __atomic_store_n(&smufs_cpu_boot, boot, __ATOMIC_RELAXED);
+    bool selected = logical >= 0 &&
+        (logical == boot || (smp != 0 && logical < 8));
+    if (selected) __atomic_add_fetch(&smufs_cpu_eligible, 1U, __ATOMIC_RELAXED);
+    else {
+        __atomic_add_fetch(&smufs_cpu_withheld, 1U, __ATOMIC_RELAXED);
+        if (logical < 0) __atomic_add_fetch(&smufs_cpu_invalid, 1U, __ATOMIC_RELAXED);
+    }
+    return selected;
+}
+extern "C" const char *native_smufs_cpu_policy_note(void)
+{
+    static char note[192];
+    // Selection observations, not claims of live secondary CPU execution.
+    snprintf(note, sizeof(note), "cpu-policy eligible%u withheld%u invalid%u boot%d smp%u slots8\n",
+        __atomic_load_n(&smufs_cpu_eligible, __ATOMIC_RELAXED),
+        __atomic_load_n(&smufs_cpu_withheld, __ATOMIC_RELAXED),
+        __atomic_load_n(&smufs_cpu_invalid, __ATOMIC_RELAXED),
+        __atomic_load_n(&smufs_cpu_boot, __ATOMIC_RELAXED),
+        __atomic_load_n(&smufs_cpu_smp, __ATOMIC_RELAXED));
+    return note;
+}
+
+
 bool
 IODTPlatformExpert::createNubs( IOService * parent, OSIterator * iter )
