+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <sys/systm.h>
+
+#include "Sm8250TouchProbe.h"
+
+extern void IOSleep(unsigned milliseconds);
+
+enum {
+    SenseOn = 0x10,
+    ReadOneEvent = 0x60,
+    ReadAllEvents = 0x61,
+    EventSize = 8,
+    MaximumTail = 31,
+    TouchDown = 1,
+    TouchMove = 2,
+    TouchUp = 3,
+};
+
+void sm8250_touch_capture_events(const GeniIo *io, void (*wait_us)(int),
+    unsigned (*irq_level)(void *), void *irq_context);
+
+static bool
+read_events(GeniI2c *bus, void (*wait_us)(int), uint8_t reg, uint8_t *data, unsigned length)
+{
+    return geni_i2c_start_read_buffer(bus, reg, data, length) == 0 &&
+           sm8250_touch_wait_i2c(bus, wait_us, 60000) == GeniDone;
+}
+
+static bool
+boot_ack(GeniI2c *bus, void (*wait_us)(int))
+{
+    for (unsigned attempt = 0; attempt < 100; ++attempt) {
+        uint8_t event[EventSize];
+        if (!read_events(bus, wait_us, ReadOneEvent, event, sizeof(event))) {
+            return false;
+        }
+        const unsigned type = (event[0] >> 2) & 0xf;
+        if ((event[0] & 3) == 1 && (type == 2 || type == 7) && event[1] == 0) {
+            printf("TOUCH42 boot ack status=%02x value=%02x\n", event[0], event[2]);
+            return true;
+        }
+        IOSleep(20);
+    }
+    return false;
+}
+
+void
+sm8250_touch_capture_events(const GeniIo *io, void (*wait_us)(int),
+    unsigned (*irq_level)(void *), void *irq_context)
+{
+    GeniI2c bus;
+    if (sm8250_touch_prepare_polling(&bus, io, NULL) != 0) {
+        printf("TOUCH42 scan complete stage=prepare\n");
+        return;
+    }
+    if (!boot_ack(&bus, wait_us)) {
+        printf("TOUCH42 scan complete stage=boot-ack error=%u irq=%x\n", bus.error, bus.error_status);
+        return;
+    }
+    const uint8_t sense = SenseOn;
+    if (geni_i2c_start_write_bytes(&bus, &sense, sizeof(sense)) != 0 ||
+        sm8250_touch_wait_i2c(&bus, wait_us, 60000) != GeniDone) {
+        printf("TOUCH42 scan complete stage=sense-on error=%u irq=%x\n", bus.error, bus.error_status);
+        return;
+    }
+
+    unsigned pressed = 0, moved = 0, irq_polls = 0, packets = 0;
+    uint64_t deadline;
+    clock_interval_to_deadline(90, NSEC_PER_SEC, &deadline);
+    printf("TOUCH42 scan ready irq=%u\n", irq_level(irq_context));
+    while (mach_absolute_time() < deadline) {
+        if (irq_level(irq_context) != 0) {
+            IOSleep(5);
+            continue;
+        }
+        ++irq_polls;
+        uint8_t events[(MaximumTail + 1) * EventSize];
+        if (!read_events(&bus, wait_us, ReadOneEvent, events, EventSize)) {
+            printf("TOUCH42 scan complete stage=first-event error=%u irq=%x\n", bus.error, bus.error_status);
+            return;
+        }
+        if (events[0] == 0) {
+            IOSleep(5);
+            continue;
+        }
+        const unsigned tail = events[7] & 0x3f;
+        if (tail > MaximumTail) {
+            printf("TOUCH42 scan complete stage=event-count count=%u\n", tail);
+            return;
+        }
+        if (tail && !read_events(&bus, wait_us, ReadAllEvents, events + EventSize, tail * EventSize)) {
+            printf("TOUCH42 scan complete stage=remaining-events count=%u error=%u irq=%x\n",
+                tail, bus.error, bus.error_status);
+            return;
+        }
+        for (unsigned i = 0; i <= tail; ++i) {
+            const uint8_t *event = events + i * EventSize;
+            ++packets;
+            if (packets == 1) {
+                printf("TOUCH42 first event=%02x %02x %02x %02x %02x %02x %02x %02x batch=%u\n",
+                    event[0], event[1], event[2], event[3], event[4], event[5], event[6], event[7], tail + 1);
+            }
+            const unsigned id = (event[0] >> 2) & 0xf;
+            const unsigned action = event[0] >> 6;
+            if ((event[0] & 3) != 0 || id < 1 || id > 10 || action == 0) {
+                continue;
+            }
+            const unsigned finger = 1u << id;
+            if (action == TouchMove && (!(pressed & finger) || (moved & finger))) {
+                continue;
+            }
+            const unsigned x = (event[1] << 4) | (event[3] >> 4);
+            const unsigned y = (event[2] << 4) | (event[3] & 0xf);
+            printf("TOUCH42 contact action=%u id=%u x=%u y=%u pressure=%u\n", action, id, x, y, event[6] & 0x3f);
+            if (action == TouchDown) {
+                pressed |= finger;
+                moved &= ~finger;
+            } else if (action == TouchMove) {
+                moved |= finger;
+            } else if (action == TouchUp) {
+                if (pressed & moved & finger) {
+                    printf("TOUCH42 scan complete stage=gesture id=%u packets=%u polls=%u\n", id, packets, irq_polls);
+                    return;
+                }
+                pressed &= ~finger;
+                moved &= ~finger;
+            }
+        }
+        IOSleep(5);
+    }
+    printf("TOUCH42 scan complete stage=timeout packets=%u polls=%u pressed=%x moved=%x\n",
+        packets, irq_polls, pressed, moved);
+}
