+int geni_i2c_start_read_buffer(GeniI2c *g, uint8_t reg, uint8_t *buffer, uint32_t length)
+{
+    if (g->phase != GeniIdle || !buffer || !length || length > UINT8_MAX) return -1;
+    g->rx_buffer = buffer;
+    g->rx_received = 0;
+    g->saved_rx_watermark = rd(g, GENI_RX_WATERMARK);
+    g->saved_irq_enable = rd(g, GENI_M_IRQ_EN);
+    wr(g, GENI_RX_WATERMARK, 1);
+    wr(g, GENI_M_IRQ_EN, g->saved_irq_enable | GENI_M_RX_ERRORS | GENI_M_RX_WATERMARK | GENI_M_RX_LAST);
+    g->reading = 1;
+    g->rx_length = (uint8_t)length;
+    g->error = GeniOk;
+    write_command(g, &reg, 1, 1);
+    return 0;
+}
+
 static int finish(GeniI2c *g, int error, uint32_t status)
 {
     g->phase = GeniIdle;
     wr(g, GENI_TX_WATERMARK, 0);
+    if (g->rx_buffer) {
+        wr(g, GENI_M_IRQ_EN, g->saved_irq_enable);
+        wr(g, GENI_RX_WATERMARK, g->saved_rx_watermark);
+        g->rx_buffer = 0;
+    }
     if (!error) {g->done++; return GeniDone;}
     g->error = (uint8_t)error;
     g->error_status = status;
     g->failed++;
     return GeniFailed;
+}
+
+static int read_buffer(GeniI2c *g, uint32_t status)
+{
+    const uint32_t fifo = rd(g, GENI_RX_FIFO_STATUS);
+    const uint32_t words = fifo & 0x1ffffffu;
+    /* Each FIFO entry contains four packed bytes. RX_LAST can shorten the last word. */
+    const uint32_t last_bytes = (fifo & (1u << 31)) ? (fifo >> 28) & 7u : 0;
+    if (words > 64 || last_bytes > 4) return finish(g, GeniErrState, status);
+    for (uint32_t word = 0; word < words; ++word) {
+        const uint32_t count = word + 1 == words && last_bytes ? last_bytes : 4;
+        if (count > g->rx_length - g->rx_received) return finish(g, GeniErrState, status);
+        const uint32_t packed = rd(g, GENI_RX_FIFO);
+        for (uint32_t byte = 0; byte < count; ++byte) {
+            g->rx_buffer[g->rx_received++] = (uint8_t)(packed >> (8 * byte));
+        }
+    }
+    if (!(status & GENI_M_CMD_DONE)) return GeniPending;
+    return finish(g, g->rx_received == g->rx_length ? GeniOk : GeniErrNoData, status);
 }
 
