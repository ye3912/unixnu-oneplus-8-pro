+/* H3J diagnoses SystemOS only. No cache is made executable or passed to dyld. */
+extern uint32_t smufs_cache_probe_device(uint32_t,uint32_t *,char *,uint64_t *,uint32_t *);
+struct SmUfsCacheProbe {
+ uint32_t stage,selected,mounted,matches,postmatches,root_before,root_after,readonly,fs_apfs,root_same;
+ uint32_t mount_enter,mount_return,files,index,main_ok,lib_ok,images,subs;
+ int mount_error,error;
+ uint64_t media,postmedia;
+ vnode_t original_root;
+ mount_t system_mount;
+ char device[64],postdevice[64],file[128];
+ uint8_t header[512],mount_data[0x150];
+};
+static uint32_t smufs_cache_u32(const uint8_t *data,size_t offset)
+{uint32_t value;memcpy(&value,data+offset,sizeof(value));return value;}
+__attribute__((noinline)) static uint32_t
+smufs_cache_root_valid(void)
+{
+ if(!smufs_saved_seen||!smufs_saved_owner||!rootvnode)return 0;
+ mount_t mounted=vnode_mount(rootvnode);vnode_t device=mounted?vfs_devvp(mounted):NULLVP;
+ dev_t actual=device?vnode_specrdev(device):NODEV;
+ uint32_t readonly=mounted&&((vfs_flags(mounted)&MNT_RDONLY)!=0);
+ if(device)vnode_put(device);
+ return readonly&&smufs_owner_root_accept((uint32_t)rootdev,(uint32_t)actual,readonly,smufs_saved_autherr);
+}
+__attribute__((noinline)) static int
+smufs_cache_probe_read(struct SmUfsCacheProbe *v,off_t offset,int bytes)
+{
+ vnode_t node=NULLVP;int error=vnode_lookup(v->file,0,&node,vfs_context_current());
+ if(error)return error;
+ if(vnode_mount(node)!=v->system_mount||vnode_vtype(node)!=VREG){vnode_put(node);return EINVAL;}
+ int residual=bytes;
+ error=vn_rdwr(UIO_READ,node,(caddr_t)v->header,bytes,offset,UIO_SYSSPACE,0,
+     vfs_context_ucred(vfs_context_current()),&residual,current_proc());
+ vnode_put(node);return error?error:(residual?EIO:0);
+}
+__attribute__((noinline,noreturn)) static void
+smufs_cache_probe_report(const char *phase,struct SmUfsCacheProbe *v)
+{
+ panic("SMUFS cache-h3j phase=%s error=%d stage%u\n"
+       "root before%u after%u same%u autherr%d owner%d\n"
+       "sys selected%x mounted%x matches%u/%u ro%u apfs%u media%llx/%llx\n"
+       "mount %u/%u errno%d path=%s\n"
+       "cache files%u/53 index%u main%u images%u subs%u lib%u\n"
+       "file %.112s\n"
+       "probe-only1 cache-exec0 sys-integrity0\n",
+       phase,v->error,v->stage,v->root_before,v->root_after,v->root_same,smufs_saved_autherr,smufs_saved_owner,
+       v->selected,v->mounted,v->matches,v->postmatches,v->readonly,v->fs_apfs,
+       (unsigned long long)v->media,(unsigned long long)v->postmedia,
+       v->mount_enter,v->mount_return,v->mount_error,v->device,v->files,v->index,v->main_ok,v->images,v->subs,v->lib_ok,v->file);
+}
+__attribute__((noinline,noreturn)) void
+native_smufs_cache_probe(uint64_t scratch)
+{
+ struct SmUfsCacheProbe *v=kalloc_data(sizeof(*v),Z_WAITOK|Z_ZERO);
+ if(!v)panic("SMUFS cache-h3j allocation failed");
+ v->selected=v->mounted=0xffffffffU;v->original_root=rootvnode;v->stage=1;
+ v->root_before=smufs_cache_root_valid();
+ if(proc_getpid(current_proc())!=1||!scratch||!v->root_before){v->error=EAUTH;smufs_cache_probe_report("root-refused",v);}
+ v->stage=2;
+ if(!smufs_cache_probe_device(0xffffffffU,&v->selected,v->device,&v->media,&v->matches)){v->error=ENOENT;smufs_cache_probe_report("volume-lookup",v);}
+ /* Existing original APFS mount ABI; scratch is the original user init page. */
+ user64_addr_t spec=scratch+0x160;uint64_t flags=MNT_RDONLY;uint16_t mode=1;uint32_t anonymous=99;
+ memcpy(v->mount_data,&spec,8);memcpy(v->mount_data+8,&flags,8);memcpy(v->mount_data+16,&mode,2);
+ memcpy(v->mount_data+0x144,&anonymous,4);memcpy(v->mount_data+0x148,&anonymous,4);
+ struct mount_args request={.type=scratch+0x100,.path=scratch+0x120,.flags=MNT_RDONLY,.data=scratch+0x200};
+ int32_t result=0;
+ v->stage=3;
+ if((v->error=copyout("apfs",request.type,5))||
+    (v->error=copyout("/private/preboot",request.path,sizeof("/private/preboot")))||
+    (v->error=copyout(v->device,spec,strlen(v->device)+1))||
+    (v->error=copyout(v->mount_data,request.data,sizeof(v->mount_data))))smufs_cache_probe_report("mount-copyout",v);
+ v->stage=4;v->mount_enter=1;v->mount_error=mount(current_proc(),&request,&result);v->mount_return=1;v->error=v->mount_error;
+ if(v->error)smufs_cache_probe_report("mount-return",v);
+ vnode_t mounted_root=NULLVP;v->stage=5;v->error=vnode_lookup("/private/preboot",0,&mounted_root,vfs_context_current());
+ if(v->error)smufs_cache_probe_report("mount-lookup",v);
+ v->system_mount=vnode_mount(mounted_root);
+ if(!v->system_mount){vnode_put(mounted_root);v->error=EINVAL;smufs_cache_probe_report("mount-null",v);}
+ vnode_t device=vfs_devvp(v->system_mount);
+ v->mounted=device?(uint32_t)vnode_specrdev(device):0xffffffffU;if(device)vnode_put(device);
+ v->readonly=(vfs_flags(v->system_mount)&MNT_RDONLY)!=0;
+ v->fs_apfs=!strcmp(vfs_statfs(v->system_mount)->f_fstypename,"apfs");vnode_put(mounted_root);
+ uint32_t fresh=0xffffffffU;
+ uint32_t bound=smufs_cache_probe_device(v->selected,&fresh,v->postdevice,&v->postmedia,&v->postmatches);
+ v->root_same=rootvnode==v->original_root;v->root_after=smufs_cache_root_valid();
+ if(!v->readonly||!v->fs_apfs||v->mounted!=v->selected||!bound||fresh!=v->selected||v->postmedia!=v->media||!v->root_same||!v->root_after){v->error=EAUTH;smufs_cache_probe_report("mount-binding",v);}
+ v->stage=6;
+ for(uint32_t i=0;i<53;++i){
+  v->index=i;int length=snprintf(v->file,sizeof(v->file),"/private/preboot/System/Library/Caches/com.apple.dyld/%s",smufs_cache_expected[i].name);
+  if(length<0||(size_t)length>=sizeof(v->file)){v->error=ENAMETOOLONG;smufs_cache_probe_report("cache-path",v);}
+  memset(v->header,0,sizeof(v->header));v->error=smufs_cache_probe_read(v,0,i?104:512);
+  if(v->error)smufs_cache_probe_report("cache-read",v);
+  if(memcmp(v->header,"dyld_v1   arm64",16)||memcmp(v->header+88,smufs_cache_expected[i].uuid,16)){v->error=EINVAL;smufs_cache_probe_report("cache-header",v);}
+  if(!i){
+   v->images=smufs_cache_u32(v->header,452);v->subs=smufs_cache_u32(v->header,396);
+   if(v->images!=3354||v->subs!=52||smufs_cache_u32(v->header,216)!=2){v->error=EINVAL;smufs_cache_probe_report("cache-main",v);}
+   v->main_ok=1;v->error=smufs_cache_probe_read(v,276462,sizeof("/usr/lib/libSystem.B.dylib"));
+   if(v->error)smufs_cache_probe_report("cache-lib-read",v);
+   if(memcmp(v->header,"/usr/lib/libSystem.B.dylib",sizeof("/usr/lib/libSystem.B.dylib"))){v->error=EINVAL;smufs_cache_probe_report("cache-lib-name",v);}
+   v->lib_ok=1;
+  }
+  ++v->files;
+ }
+ v->stage=7;v->root_same=rootvnode==v->original_root;v->root_after=smufs_cache_root_valid();
+ if(!v->root_same||!v->root_after){v->error=EAUTH;smufs_cache_probe_report("root-recheck",v);}
+ smufs_cache_probe_report("cache-probe-complete",v);
+}
