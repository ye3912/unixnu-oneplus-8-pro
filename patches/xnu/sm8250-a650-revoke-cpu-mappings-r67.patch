+void
+IOMemoryDescriptor::markNativeAdrenoCpuView()
+{
+    // A freshly constructed physical descriptor has not been published yet.
+    _internalFlags |= kNativeAdrenoCpuView;
+}
+
+IOReturn
+IOMemoryDescriptor::revokeNativeAdrenoCpuView()
+{
+    LOCK;
+    assert(_internalFlags & kNativeAdrenoCpuView);
+    _internalFlags |= kNativeAdrenoCpuViewRevoked;
+    __block IOReturn status = (_internalFlags & kNativeAdrenoCpuViewUnmapFailed)
+        ? kIOReturnVMError : kIOReturnSuccess;
+    if (_mappings && status == kIOReturnSuccess) {
+        _mappings->iterateObjects(^(OSObject *object) {
+            status = static_cast<IOMemoryMap *>(object)->unmap();
+            return status != kIOReturnSuccess;
+        });
+    }
+    UNLOCK;
+    return status;
+}
