+static int
+slider_tcs_read(void *ctx, uint32_t off, uint32_t *value)
+{
+    if (off >= RscTcsStride || (off & 3)) return -1;
+    *value = slider_read(ctx, off);
+    return 0;
+}
+
+static int
+slider_tcs_write(void *ctx, uint32_t off, uint32_t value)
+{
+    if (off >= RscTcsStride || (off & 3)) return -1;
+    slider_write(ctx, off, value);
+    return 0;
+}
+
+static uint64_t
+slider_now_us(void *ctx)
+{
+    (void)ctx;
+    uint64_t ns;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+    return ns / 1000;
+}
+
+static bool
+slider_pmic(uint32_t apid, uint32_t off, uint8_t *value)
+{
+    uint8_t second = 0;
+    return kebab_spmi_obs_read_ex(apid, L10Sid, L10Base + off, 1, false, true, value) == 0 &&
+        kebab_spmi_obs_read_ex(apid, L10Sid, L10Base + off, 2, false, true, &second) == 0 && *value == second;
+}
+
+static bool
