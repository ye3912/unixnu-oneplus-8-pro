+{
+    kebab_rpmh_cmd cmd;
+    kebab_rpmh_status rc = enable ? kebab_rpmh_encode_enable("ldoc10", &cmd) :
+        kebab_rpmh_encode_voltage("ldoc10", 3008, &cmd);
+    if (rc != KEBAB_RPMH_OK) return false;
+    rc = kebab_rpmh_tcs_send(channel, &cmd);
+    printf("SLIDER rpmh reg=%s addr=%x data=%u result=%d phase=%u status=%x\n",
+        enable ? "enable" : "voltage", cmd.addr, cmd.data, rc, channel->phase, channel->last_status);
+    return rc == KEBAB_RPMH_OK;
 }
 
