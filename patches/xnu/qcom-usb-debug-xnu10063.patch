+#if XNU_QCOM_USB_DEBUG
+/* Exact Mach-private declarations hidden from the BSD translation unit. */
+extern processor_t thread_bind(processor_t processor);
+extern void thread_terminate_self(void);
+static unsigned qcom_usb_worker_started;
+static char qcom_usb_status_note[160];static unsigned qcom_usb_status_ready;
+const char *native_sm_usb_status_note(void) {
+ return __atomic_load_n(&qcom_usb_status_ready,__ATOMIC_ACQUIRE)?qcom_usb_status_note:"SMUSB21 worker status unavailable\n";
+}
+static void qcom_usb_log_worker(void *arg __unused, wait_result_t result __unused)
+{
+ processor_t processor = cpu_to_processor(master_cpu);
+ struct qcom_usb_debug_status status = {0};
+ thread_set_thread_name(current_thread(), "qcom-usb-log");
+ if (processor == PROCESSOR_NULL) goto out;
+ thread_bind(processor); thread_block(THREAD_CONTINUE_NULL);
+ if (cpu_number() != master_cpu) goto out;
+ qcom_usb_debug_get_status(&status);
+ snprintf(qcom_usb_status_note,sizeof(qcom_usb_status_note),
+  "SMUSB21 worker cpu%d ph%u err%u prep%u st%u dma%u dom%u bank%u slot%u\n",
+  cpu_number(),status.phase,status.error,status.prepare_result,status.prepare_stage,
+  status.dma_mode,status.domain_result,status.domain_bank,status.domain_slot);
+ __atomic_store_n(&qcom_usb_status_ready,1U,__ATOMIC_RELEASE);
+ printf("SMUSB21 worker cpu%d phase%u err%u prep%u stage%u dma%u domain%u\n",
+  cpu_number(),status.phase,status.error,status.prepare_result,status.prepare_stage,status.dma_mode,status.domain_result);
+ if (status.phase == QCOM_USB_DEBUG_ACTIVE && status.dma_mode == QCOM_USB_DEBUG_DMA_PRIVATE_TRANSLATED)
+  printf("PLATFORM-DMA usb pa=%llx iova=%llx tables=%llx bank=%u slot=%u dma_bits=%u\n",
+   status.dma_pa,status.dma_iova,status.tables_pa,status.domain_bank,status.domain_slot,status.dma_address_width);
+ while (!panic_active()) {
+  uint64_t deadline;
+  qcom_usb_debug_get_status(&status);
+  if (status.phase != QCOM_USB_DEBUG_ACTIVE) break;
+  qcom_usb_debug_poll();
+  clock_interval_to_deadline(5,NSEC_PER_MSEC,&deadline);
+  if (assert_wait_deadline((event_t)&qcom_usb_worker_started,THREAD_UNINT,deadline)==THREAD_WAITING)
+   thread_block(THREAD_CONTINUE_NULL);
+ }
+out:
+ thread_bind(PROCESSOR_NULL);thread_terminate_self();
+}
+static void qcom_usb_start_log_worker(void)
+{
+ int enabled=0;unsigned expected=0;thread_t worker=THREAD_NULL;
+ if (!PE_parse_boot_argn("qcom-usb-debug",&enabled,sizeof(enabled)) || enabled!=1) return;
+ if (!__atomic_compare_exchange_n(&qcom_usb_worker_started,&expected,1,0,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE)) return;
+ kern_return_t result=kernel_thread_start(qcom_usb_log_worker,NULL,&worker);
+ if (result==KERN_SUCCESS) thread_deallocate(worker);
+ else printf("SMUSB21 worker failed %d\n",result);
+}
