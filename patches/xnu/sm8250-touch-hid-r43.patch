+static bool
+publish_frame(const SmTouchFrame *frame)
+{
+    const unsigned prior = sm8250_touch_hid_reports_ok();
+    native_touch_seq++;
+    __asm__ volatile("dmb ish" ::: "memory");
+    unsigned count = 0;
+    for (unsigned i = 0; i < SmTouchFingers; ++i) {
+        if (!(frame->active & (1u << i))) continue;
+        const SmTouchContact *contact = &frame->contacts[i];
+        native_touch_ids[count] = contact->id;
+        native_touch_xs[count] = contact->x;
+        native_touch_ys[count] = contact->y;
+        ++count;
+    }
+    native_touch_count = count;
+    __asm__ volatile("dmb ish" ::: "memory");
+    native_touch_seq++;
+    sm8250_touch_notify();
+    return sm8250_touch_hid_reports_ok() != prior;
+}
