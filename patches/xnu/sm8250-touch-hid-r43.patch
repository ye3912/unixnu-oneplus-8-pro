+static void
+publish_contact(SmTouchFrame *frame, const SmTouchContact *contact,
+    unsigned *pressed, unsigned *moved, bool *gesture)
+{
+    const unsigned bit = 1u << contact->id;
+    const SmTouchContact previous = frame->contacts[contact->id - 1];
+    const bool accepted = sm8250_touch_apply(frame, contact) && publish_frame(frame);
+    if (contact->action == SmTouchDown) {
+        *pressed = accepted ? *pressed | bit : *pressed & ~bit;
+        *moved &= ~bit;
+    } else if (contact->action == SmTouchMove && accepted &&
+               (previous.x != contact->x || previous.y != contact->y)) {
+        *moved |= bit;
+    } else if (contact->action == SmTouchUp) {
+        if (!*gesture && accepted && (*pressed & *moved & bit)) {
+            printf("TOUCH43 HID gesture id=%u x=%u y=%u reports=%u\n",
+                contact->id, contact->x, contact->y, sm8250_touch_hid_reports_ok());
+            *gesture = true;
+        }
+        *pressed &= ~bit;
+        *moved &= ~bit;
+    }
+}
 
