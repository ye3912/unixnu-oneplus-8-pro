+    unsigned stage = 1;
+    int error = EAUTH;
+    if (!smufs_aks_fresh_data_ready() || !scratch || scratch > UINT64_MAX - 4096 ||
+        proc_getpid(current_proc()) != 1 || !native_ram_block_gpu_addon(&addon, &bytes) ||
+        bytes != 10637096) goto done;
