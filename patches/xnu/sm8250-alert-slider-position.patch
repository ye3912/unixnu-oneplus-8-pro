--- /dev/null
+++ b/bsd/dev/In2020SliderPosition.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef IN2020_SLIDER_POSITION_H
+#define IN2020_SLIDER_POSITION_H
+/* This handset only: labelled 20261112-185615 capture, user confirmed top boot,
+ * middle/bottom/middle/top. Difference centers -232/-9/223; sum -483/-459/-487.
+ * Factory oplus_tri_key.c initialCalibValue uses 40% of adjacent difference
+ * spacing for internal bounds; judge_interference uses sum tolerance 40.
+ * Use bounded symmetric windows rather than the vendor's broad outer tails.
+ * No proprietary ringer usage or Linux input event is inferred here.
+ */
+struct in2020_slider_position {
+    unsigned candidate, count, committed;
+    unsigned long long since_ms, last_ms;
+};
+
+static inline int in2020_slider_abs(int value) { return value < 0 ? -value : value; }
+
+static inline unsigned
+in2020_slider_candidate(int down, int up, unsigned down_status, unsigned up_status)
+{
+    static const int diff_centers[] = {-232, -9, 223};
+    static const int sum_centers[] = {-483, -459, -487};
+    /* floor(223*0.4), floor(min(223,232)*0.4), floor(232*0.4). */
+    static const int half_width[] = {89, 89, 92};
+    if (!(down_status & 5) || !(up_status & 5)) return 0;
+    const int diff = up-down, sum = up+down;
+    for (unsigned i=0; i<3; ++i) {
+        if (in2020_slider_abs(diff-diff_centers[i]) <= half_width[i] &&
+            in2020_slider_abs(sum-sum_centers[i]) <= 40) return i+1;
+    }
+    return 0;
+}
+
+/* Return only a new confirmed state: 1 top, 2 middle, 3 bottom; zero=no event.
+ * Debounce is board policy (3 valid pairs across >=200ms, gaps <=500ms), not
+ * a claimed factory constant. Raw sensor pairs arrive about every 135ms.
+ */
+static inline unsigned
+in2020_slider_update(struct in2020_slider_position *s, unsigned long long ms,
+    int down, int up, unsigned down_status, unsigned up_status)
+{
+    const unsigned candidate = in2020_slider_candidate(down, up, down_status, up_status);
+    if (!candidate || candidate != s->candidate || ms < s->last_ms || ms-s->last_ms > 500) {
+        s->candidate = candidate;
+        s->count = candidate ? 1 : 0;
+        s->since_ms = ms;
+    } else if (s->count < 3) {
+        ++s->count;
+    }
+    s->last_ms = ms;
+    if (!candidate || s->count < 3 || ms-s->since_ms < 200 || candidate == s->committed) return 0;
+    s->committed = candidate;
+    return candidate;
+}
+#endif
