 	mr = ipc_kmsg_copyout(kmsg, space, map, options);
 
 	if (mr != MACH_MSG_SUCCESS) {
@@ -376,6 +640,9 @@
 		    options, map, mr);
 	}
 	/* kmsg freed */
+#if (DEVELOPMENT || DEBUG) && defined(__arm64__)
+	pk30_finish(pk30_received, true, mr);
+#endif
 
 out:
 	if (msgr_out) {
@@ -728,7 +995,13 @@
 		return mr;
 	}
 
+#if (DEVELOPMENT || DEBUG) && defined(__arm64__)
+	struct pk30_event pk30_sent = pk30_send(kmsg);
