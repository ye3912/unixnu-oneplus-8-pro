+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <sys/systm.h>
+#include <vm/memory_types.h>
+
+#define KEBAB_RPMH_KERNEL 1
+#include "KebabRpmhVrm.h"
+#include "kebab_spmi_bus.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, uint32_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+bool sm8250_touch_power_on(void);
+
+enum {
+    CommandDbPa = 0x80860000,
+    CommandDbSize = 0x20000,
+    RscDrv2Pa = 0x18220000,
+    RscSize = 0x4000,
+    RscTcsBase = 0xd00,
+    RscParentChild = 0x0c,
+    RscTcsStride = 0x2a0,
+    SpmiCoreMapSize = 0x2000,
+    RegulatorType = 4,
+    EnableOn = 0x80,
+};
+
+struct rail {
+    const char *name;
+    uint32_t addr, sid, base;
+    uint16_t millivolts;
+    uint8_t subtype, enabled;
+    uint32_t apid;
+};
+
+static int
+read_tcs(void *ctx, uint32_t offset, uint32_t *value)
+{
+    if (offset >= RscTcsStride || (offset & 3)) {
+        return -1;
+    }
+    *value = kebab_spmi_rd((vm_offset_t)ctx, offset);
+    return 0;
+}
+
+static int
+write_tcs(void *ctx, uint32_t offset, uint32_t value)
+{
+    if (offset >= RscTcsStride || (offset & 3)) {
+        return -1;
+    }
+    kebab_spmi_wr((vm_offset_t)ctx, offset, value);
+    return 0;
+}
+
+static uint64_t
+now_us(void *ctx)
+{
+    (void)ctx;
+    uint64_t ns;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+    return ns / 1000;
+}
+
+static bool
+read_pmic(const struct rail *rail, uint32_t offset, uint8_t *value)
+{
+    uint8_t second;
+    const uint32_t reg = rail->base + offset;
+    return kebab_spmi_obs_read_ex(rail->apid, rail->sid, reg, 1, false, false, value) == 0 &&
+        kebab_spmi_obs_read_ex(rail->apid, rail->sid, reg, 2, false, false, &second) == 0 &&
+        *value == second;
+}
+
+static bool
+check_rail(struct rail *rail, const uint8_t *db)
+{
+    uint32_t addr = 0;
+    struct kebab_spmi_match match;
+    const uint32_t ppid = (rail->sid << 8) | (rail->base >> 8);
+    if (kebab_rpmh_cmd_db_lookup(db, CommandDbSize, rail->name, &addr) != KEBAB_RPMH_OK ||
+        addr != rail->addr || kebab_spmi_scan(ppid, &match, 1) != 1 || match.write_ee != 4) {
+        printf("TOUCH39 rail %s identity refused addr=%x ppid=%x\n", rail->name, addr, ppid);
+        return false;
+    }
+    rail->apid = match.apid;
+    uint8_t type = 0, subtype = 0, lo = 0, hi = 0;
+    /* PMIC5 510 LDOs hold the configured voltage in millivolts, LSB first. */
+    bool readable = read_pmic(rail, 4, &type) && read_pmic(rail, 5, &subtype) &&
+        read_pmic(rail, 0x40, &lo) && read_pmic(rail, 0x41, &hi) &&
+        read_pmic(rail, 0x46, &rail->enabled);
+    uint16_t mv = ((uint16_t)hi << 8) | lo;
+    printf("TOUCH39 rail %s read=%u apid=%x type=%x/%x mv=%u en=%x\n",
+        rail->name, readable, rail->apid, type, subtype, mv, rail->enabled);
+    return readable && type == RegulatorType && subtype == rail->subtype &&
+        mv == rail->millivolts && (rail->enabled == 0 || rail->enabled == EnableOn);
+}
+
+static bool
+enable_rail(const struct rail *rail, kebab_rpmh_tcs *channel)
+{
+    if (rail->enabled == EnableOn) {
+        return true;
+    }
+    kebab_rpmh_cmd command;
+    if (kebab_rpmh_encode_enable(rail->name, &command) != KEBAB_RPMH_OK) {
+        return false;
+    }
+    kebab_rpmh_status result = kebab_rpmh_tcs_send(channel, &command);
+    uint8_t en = 0;
+    bool on = result == KEBAB_RPMH_OK && read_pmic(rail, 0x46, &en) && en == EnableOn;
+    printf("TOUCH39 rail %s send=%d phase=%u status=%x en=%x\n",
+        rail->name, result, channel->phase, channel->last_status, en);
+    return on;
+}
+
+static bool
+power_on(vm_offset_t db, vm_offset_t rsc)
+{
+    uint32_t version = kebab_spmi_rd(spmi.core, KEBAB_SPMI_VERSION);
+    uint32_t parent = kebab_spmi_rd(rsc, RscParentChild);
+    uint32_t irq_enable = kebab_spmi_rd(rsc + RscTcsBase, 0);
+    uint32_t irq_status = kebab_spmi_rd(rsc + RscTcsBase, 4);
+    printf("TOUCH39 power version=%x parent=%x irq=%x/%x\n", version, parent, irq_enable, irq_status);
+    if (version < 0x50000000u || version >= 0x70000000u ||
+        ((parent >> 12) & 0x3f) != 8 || ((parent >> 27) & 0x1f) != 16 ||
+        ((irq_enable | irq_status) & (1u << 1))) {
+        return false;
+    }
+    /* IN2020 stock order and voltages, GF SM8250 regulator identities. */
+    struct rail digital = {.name = "ldoc1", .addr = 0x42f00, .sid = 5,
+                           .base = 0x4000, .millivolts = 1800, .subtype = 0x71};
+    struct rail analog = {.name = "ldoa13", .addr = 0x40c00, .sid = 1,
+                          .base = 0x4c00, .millivolts = 3008, .subtype = 0x7b};
+    if (!check_rail(&digital, (const uint8_t *)db) || !check_rail(&analog, (const uint8_t *)db) ||
+        (digital.enabled == 0 && analog.enabled != 0)) {
+        return false;
+    }
+    kebab_rpmh_tcs channel;
+    kebab_tcs_io io = {read_tcs, write_tcs, now_us, (void *)(rsc + RscTcsBase + RscTcsStride)};
+    kebab_rpmh_tcs_init_global(&channel, io);
+    if (!enable_rail(&digital, &channel)) {
+        return false;
+    }
+    delay(1000);
+    return enable_rail(&analog, &channel);
+}
+
+bool
+sm8250_touch_power_on(void)
+{
+    spmi.core = ml_io_map_unmappable(KEBAB_SPMI_CORE_PA, SpmiCoreMapSize, VM_WIMG_IO);
+    spmi.cnfg = ml_io_map_unmappable(KEBAB_SPMI_CNFG_PA, KEBAB_SPMI_CNFG_SIZE, VM_WIMG_IO);
+    spmi.obsrvr = ml_io_map_unmappable(KEBAB_SPMI_OBSRV_PA, KEBAB_SPMI_OBSRV_SIZE, VM_WIMG_IO);
+    vm_offset_t db = ml_io_map_unmappable(CommandDbPa, CommandDbSize, VM_WIMG_IO);
+    vm_offset_t rsc = ml_io_map_unmappable(RscDrv2Pa, RscSize, VM_WIMG_IO);
+    bool ready = false;
+    if (spmi.core && spmi.cnfg && spmi.obsrvr && db && rsc) {
+        ready = power_on(db, rsc);
+    } else {
+        printf("TOUCH39 power mapping failed\n");
+    }
+    if (rsc) {
+        ml_io_unmap(rsc, RscSize);
+    }
+    if (db) {
+        ml_io_unmap(db, CommandDbSize);
+    }
+    if (spmi.obsrvr) {
+        ml_io_unmap(spmi.obsrvr, KEBAB_SPMI_OBSRV_SIZE);
+        spmi.obsrvr = 0;
+    }
+    if (spmi.cnfg) {
+        ml_io_unmap(spmi.cnfg, KEBAB_SPMI_CNFG_SIZE);
+        spmi.cnfg = 0;
+    }
+    if (spmi.core) {
+        ml_io_unmap(spmi.core, SpmiCoreMapSize);
+        spmi.core = 0;
+    }
+    return ready;
+}
